@*
    Views/Shared/_DashboardLayout.cshtml — COMPLETE REPLACEMENT.

    This replaces the bootstrap sidebar shell with the EduSathi sidebar from
    Site.Master. Everything functional in the original file is preserved:

      - @@inject SignInManager / UserManager               -> kept
      - "Hi, {firstName}" greeting from ApplicationUser    -> kept (now the sidebar footer)
      - Identity-area logout form with returnUrl           -> kept, byte-for-byte route values
      - jquery + bootstrap.bundle + site.js script tags    -> REMOVED, see note below
      - RenderSectionAsync("Scripts")                      -> kept

    Removed scripts: this layout no longer loads bootstrap.min.css,
    bootstrap.bundle.min.js, jquery or ~/css/site.css. None of the migrated views
    use a bootstrap component, and loading bootstrap's reboot alongside
    edusathi.css makes both fight over html/body backgrounds.

    IF YOU ADD A PAGE THAT NEEDS JQUERY VALIDATION: add it per-page via
    @@section Scripts { <partial name="_ValidationScriptsPartial" /> } and pull
    jquery in there, or add the two script tags back here.

    The inline <style> block from the original is gone — those rules are now in
    wwwroot/css/edusathi.css under .sidebar / .app-shell / .nav-item.
*@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var controller = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    var action = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();

    // Site.Master.cs picked the active link from the .aspx filename; RouteData is
    // the ASP.NET Core equivalent.
    var isHome = controller == "exam" && action == "index";
    var isHistory = controller == "exam" && action == "history";
    var isQuestionnaires = controller == "questionnaires" && action != "myquizzes";
    var isMyQuizzes = controller == "questionnaires" && action == "myquizzes";
    var isProfile = controller == "profile";

    string displayName = User.Identity?.Name ?? "";
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(currentUser?.FullName))
        {
            displayName = currentUser!.FullName;
        }
    }

    var initials = "";
    foreach (var part in displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries))
    {
        if (initials.Length >= 2) break;
        initials += char.ToUpperInvariant(part[0]);
    }
    if (initials.Length == 0) { initials = "?"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduSathi</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/edusathi.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="app-shell">

        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-badge"><i class="bi bi-mortarboard-fill"></i></div>
                <div class="logo-text">EduSathi</div>
            </div>

            <ul class="nav-list">
                <li>
                    <a class="nav-item @(isHome ? "active" : "")" asp-controller="Exam" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i><span>Home</span>
                    </a>
                </li>
                <li>
                    <a class="nav-item @(isHistory ? "active" : "")" asp-controller="Exam" asp-action="History">
                        <i class="bi bi-clock-history"></i><span>History</span>
                    </a>
                </li>
                <li>
                    <a class="nav-item @(isQuestionnaires ? "active" : "")" asp-controller="Questionnaires" asp-action="Index">
                        <i class="bi bi-patch-question-fill"></i><span>Questionnaires</span>
                       
                    </a>
                </li>
                <li>
                    <a class="nav-item @(isMyQuizzes ? "active" : "")" asp-controller="Questionnaires" asp-action="MyQuizzes">
                        <i class="bi bi-trophy-fill"></i><span>My Quizzes</span>
                    </a>
                </li>
                <li>
                    <a class="nav-item @(isProfile ? "active" : "")" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-fill"></i><span>Profile</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="sidebar-user" asp-controller="Profile" asp-action="Index">
                        <div class="avatar">@initials</div>
                        <div>
                            <div class="name">@displayName</div>
                            @* TODO(backend): no attempt/streak table exists yet, so this
                               label is static. Wire it up when scoring is persisted. *@
                            <div class="streak"><i class="bi bi-mortarboard"></i> Keep going</div>
                        </div>
                    </a>

                    @* Preserved verbatim from the original _DashboardLayout: Identity
                       handles sign-out, not AccountController. *@
                    <form class="w-100" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          style="margin-top:12px;">
                        <button type="submit" class="btn btn-secondary btn-block">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                }
            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/edusathi.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
