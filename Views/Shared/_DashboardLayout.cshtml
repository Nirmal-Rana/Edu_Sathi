@*
    Views/Shared/_DashboardLayout.cshtml — COMPLETE REPLACEMENT.

    This replaces the bootstrap sidebar shell with the EduSathi sidebar from
    Site.Master. Everything functional in the original file is preserved:

      - @inject SignInManager / UserManager               -> kept
      - "Hi, {firstName}" greeting from ApplicationUser    -> kept (now the sidebar footer)
      - Identity-area logout form with returnUrl           -> kept, byte-for-byte route values
      - jquery + bootstrap.bundle + site.js script tags    -> REMOVED, see note below
      - RenderSectionAsync("Scripts")                      -> kept

    Removed scripts: this layout no longer loads bootstrap.min.css,
    bootstrap.bundle.min.js, jquery or ~/css/site.css. None of the migrated views
    use a bootstrap component, and loading bootstrap's reboot alongside
    edusathi.css makes both fight over html/body backgrounds.

    IF YOU ADD A PAGE THAT NEEDS JQUERY VALIDATION: add it per-page via
    @section Scripts { <partial name="_ValidationScriptsPartial" /> } and pull
    jquery in there, or add the two script tags back here.

    The inline <style> block from the original is gone — those rules are now in
    wwwroot/css/edusathi.css under .sidebar / .app-shell / .nav-item.
*@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var controller = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    var action = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();

    string displayName = User.Identity?.Name ?? "";
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(currentUser?.FullName))
        {
            displayName = currentUser!.FullName;
        }
    }

    var initials = "";
    foreach (var part in displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries))
    {
        if (initials.Length >= 2) break;
        initials += char.ToUpperInvariant(part[0]);
    }
    if (initials.Length == 0) { initials = "?"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduSathi</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/edusathi.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="app-shell">

        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-badge"><i class="bi bi-mortarboard-fill"></i></div>
                <div class="logo-text">EduSathi</div>
            </div>

            <hr class="text-muted mx-3" />

            <!-- Sidebar Links with Dynamic Active Highlighting -->
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Exam" ? "active" : "")" asp-controller="Exam" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" asp-controller="Questionaries" asp-action="Profile">
                        <i class="bi bi-person-badge"></i> Profile
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Friends") ? "active" : "")" asp-controller="Friends" asp-action="Index">
                        <i class="bi bi-people-fill me-2"></i> Friends
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "RoomInvites" ? "active" : "")" asp-controller="Questionaries" asp-action="RoomInvites">
                        <i class="bi bi-bell-fill text-warning me-2"></i> Room Invites
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(controller == "questionnaires" && action == "index" ? "active" : "")" asp-controller="Questionnaires" asp-action="Index">
                        <i class="bi bi-collection-fill"></i> Questionnaires
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(action == "history" ? "active" : "")" asp-controller="Exam" asp-action="History">
                        <i class="bi bi-clock-history"></i> History
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="sidebar-user" asp-controller="Questionnaires" asp-action="Profile">
                        <div class="avatar">@initials</div>
                        <div>
                            <div class="name">@displayName</div>
                            <div class="streak"><i class="bi bi-mortarboard"></i> Keep going</div>
                        </div>
                    </a>

                    <form class="w-100" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          style="margin-top:12px;">
                        <button type="submit" class="btn btn-secondary btn-block">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                }
            </div>
        </aside>

        <!-- Main Content Area -->
        <main>
            @RenderBody()
        </main>
    </div>

    <script src="~/js/edusathi.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>