***REMOVED***@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduSathi Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                background-color: #f8f9fa;
            }

            .sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 100;
                padding: 20px 0;
                box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
                background-color: #ffffff;
                width: 250px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

                .sidebar .nav-link {
                    font-weight: 500;
                    color: #333;
                    padding: 12px 20px;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                    .sidebar .nav-link:hover, .sidebar .nav-link.active {
                        color: #0d6efd;
                        background-color: #f1f5f9;
                    }

            main {
                margin-left: 250px;
                padding: 40px;
            }
    </style>
</head>
<body>

    <!-- Persistent Sidebar -->
    <nav class="sidebar">
        <div>
            <!-- Brand & Greeting Section -->
            <div class="px-4 mb-3">
                <h4 class="text-primary fw-bold mb-1">EduSathi</h4>
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var firstName = currentUser?.FullName?.Split(' ')[0] ?? User.Identity?.Name;
                    <span class="text-muted small fw-medium">Hi, @firstName</span>
                }
            </div>

            <hr class="text-muted mx-3" />

            <!-- Sidebar Links -->
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Exam" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-journal-text"></i> My Quizzes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </li>
            </ul>
        </div>

        <!-- Logout Button at the bottom of the sidebar -->
        @if (SignInManager.IsSignedIn(User))
        {
            <div class="px-3 pb-3">
                <form class="w-100" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        }
    </nav>

    <!-- Main Content Area (Top Navbar Completely Removed) -->
    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>