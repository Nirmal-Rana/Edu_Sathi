@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "User Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 bg-white p-4">
                <div class="text-center mb-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark">@Model.UserName</h3>
                    <p class="text-muted">EduSathi Learner & Competitor</p>
                </div>

                <hr class="mb-4" />

                <!-- User Statistics Grid -->
                <div class="row text-center mb-4">
                    <div class="col-6">
                        <div class="p-3 border rounded bg-light">
                            <span class="d-block text-muted small text-uppercase">Quizzes Attended</span>
                            <h3 class="fw-bold text-primary mb-0">@ViewBag.TotalQuizzes</h3>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border rounded bg-light">
                            <span class="d-block text-muted small text-uppercase">Avg. Performance</span>
                            <h3 class="fw-bold text-success mb-0">@ViewBag.AverageScore%</h3>
                        </div>
                    </div>
                </div>

                <!-- Account Information Details -->
                <h5 class="fw-bold mb-3 text-secondary">Account Information</h5>
                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Username / Email:</span>
                        <span class="text-dark">@Model.Email</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Phone Number:</span>
                        <span class="text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Account Status:</span>
                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Active</span>
                    </li>
                </ul>

                <div class="d-flex justify-content-between">
                    <a asp-action="History" class="btn btn-outline-primary px-4"><i class="bi bi-clock-history me-1"></i> View Full History</a>
                    <a asp-action="Index" class="btn btn-primary px-4">Back to Hub</a>
                </div>
            </div>
        </div>
    </div>
</div>