@{
    ViewData["Title"] = "Questionaries Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Questionaries Hub</h2>
    <div class="row g-4">
        <!-- Join Room Card -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4 text-center h-100 border-0 bg-white">
                <div class="card-body">
                    <i class="bi bi-door-open display-4 text-primary mb-3"></i>
                    <h4 class="card-title fw-bold">Join a Room</h4>
                    <p class="text-muted">Enter a shareable code given by your peer to join a live global room and compete in real-time.</p>
                    <form asp-action="JoinRoom" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <div class="input-group mb-3">
                            <input type="text" name="roomCode" class="form-control" placeholder="Enter Room Code..." required />
                            <button class="btn btn-primary" type="submit">Join</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Create Custom Card -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4 text-center h-100 border-0 bg-white">
                <div class="card-body">
                    <i class="bi bi-plus-circle display-4 text-success mb-3"></i>
                    <h4 class="card-title fw-bold">Create Custom</h4>
                    <p class="text-muted">Upload multiple PDFs, pick categories like Solo or Global, and share custom quiz rooms with others.</p>
                    <a asp-action="CreateCustom" class="btn btn-success mt-4 px-4">Create Now</a>
                </div>
            </div>
        </div>
    </div>
</div>