@model List<EduSathi.Models.UploadedDocument>

@{
    ViewData["Title"] = "Questionaries Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <!-- Main Column: Documents & Create Option -->
        <div class="col-md-8">
            <div class="card shadow-sm p-4 border-0 bg-white mb-4">
                <h3 class="fw-bold text-primary mb-3">Questionaries Hub</h3>
                <p class="text-muted">Manage your uploaded study documents or create new AI-generated quiz sessions.</p>

                <div class="d-flex gap-3 mt-3">
                    <a asp-action="CreateCustom" class="btn btn-primary">Create Custom Quiz / Room</a>
                </div>
            </div>

            <!-- Uploaded Documents Section -->
            <div class="card shadow-sm p-4 border-0 bg-white">
                <h4 class="fw-bold text-dark mb-3">
                    <i class="bi bi-file-earmark-text text-primary me-2"></i> Your Uploaded Documents
                </h4>

                @if (Model == null || !Model.Any())
                {
                    <p class="text-muted">You haven't uploaded any documents yet. Create a custom room or upload a PDF to get started!</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var doc in Model)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-primary">@doc.FileName</h5>
                                    <small class="text-muted">Uploaded on: @doc.UploadedAt.ToString("g")</small>
                                </div>
                                <a asp-controller="Quiz" asp-action="QuizSession" asp-route-id="@doc.Id" class="btn btn-outline-primary btn-sm">
                                    Start Solo Quiz <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Column: Quick Join via Code -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4 border-0 bg-white">
                <h5 class="fw-bold mb-3">Join Room with Code</h5>
                <form asp-action="JoinRoom" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <input type="text" name="roomCode" class="form-control text-uppercase" placeholder="Enter 6-digit Code" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Join Room</button>
                </form>
            </div>
        </div>
    </div>
</div>