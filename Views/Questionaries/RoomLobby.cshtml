@model EduSathi.Models.CustomRoom

@{
    ViewData["Title"] = "Room Lobby";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4 border-0 bg-white text-center">
        <h2 class="fw-bold text-primary">@Model.RoomName</h2>
        <p class="text-muted">Share this code with your peers so they can join your live room.</p>

        <div class="my-4">
            <span class="text-uppercase tracking-wider text-muted small d-block mb-1">Shareable Room Code</span>
            <h1 class="display-3 fw-bold text-dark bg-light py-3 rounded border d-inline-block px-5">@Model.RoomCode</h1>
        </div>

        <hr class="my-4" />

        <h4 class="fw-bold text-start mb-3">Joined Participants</h4>
        <ul class="list-group text-start mb-4">
            @foreach (var participant in Model.Participants)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-circle text-primary me-2"></i> @participant.UserName</span>
                    <span class="badge bg-secondary">Joined</span>
                </li>
            }
        </ul>

        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to Hub</a>
            <a asp-action="LiveQuiz" asp-route-roomCode="@Model.RoomCode" class="btn btn-success px-4">Start Live Quiz</a>
        </div>
    </div>
</div>