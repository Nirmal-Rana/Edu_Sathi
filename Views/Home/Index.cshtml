@*
    Views/Home/Index.cshtml — COMPLETE REPLACEMENT.

    Dark landing page: navbar + hero + Features, How it works, About, CTA, footer.

    - Self-contained: Layout = null, so this page does NOT use _PublicLayout. All
      CSS is inline and every icon is inline SVG, so it can't clash with site.css.
    - The navbar is a copy of the one on the Login / Register pages
      (Home, Features, How It Works, About + Login / Register).
    - AUTO-FIT: everything below the navbar is sized in rem, and the root font size
      is calculated from the screen height and width, so the hero fills one default
      screen on any laptop or monitor. Tune it with the "46" in the html { } rule:
        raise it (48, 50)  -> page gets smaller
        lower it (44, 42)  -> page gets bigger
      The navbar is in px on purpose so it stays identical to the Login page.
    - No gradients: every background is a solid colour.
    - HomeController.Index is unchanged: signed-in users are redirected to
      Exam/Index, anonymous visitors get this page.

    HERO PHOTO: embedded in this file (data URI on the <img class="frame-img"> tag),
    so no wwwroot/images file is needed. To swap it later, replace that src with
    ~/images/your-photo.jpg and put the file in wwwroot/images (a ready-made hero.jpg
    is included next to this file).
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EduSathi — Your notes, made study-ready</title>
    <meta name="description" content="Upload a PDF. Get the important ideas, practice at your level, and turn any chapter into a focused study session." />
    <meta name="theme-color" content="#050b1e" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg: #050b1e;
            --surface: #0c1329;
            --surface-2: #10182f;
            --line: #1b2542;
            --text: #ffffff;
            --text-soft: #c5cad8;
            --text-muted: #a3abbe;
            --orange: #ff5c00;
            --orange-soft: rgba(255, 92, 0, .13);
            --indigo: #5b58f4;
            --indigo-hover: #4d4ae6;
            --indigo-soft: rgba(91, 88, 244, .16);
            --indigo-text: #8f8dff;
            --purple: #7c5cf5;
            --ink: #0a1024;
            --display: "Plus Jakarta Sans", "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            --body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; }

        /* ===== AUTO-FIT: the whole page scales from this one rule =====
           root size = (screen height - 74px navbar) / 46, limited by screen width,
           and kept between 10px and 18px. Change 46 to resize everything. */
        html {
            font-size: 75%; /* fallback for very old browsers */
            font-size: clamp(10px, min(calc((100vh - 74px) / 46), calc(100vw / 80)), 18px);
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        html, body { margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--body);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: 100vh;
            overflow-x: hidden;
        }

        a { color: inherit; text-decoration: none; }

        svg.ic {
            width: 1em;
            height: 1em;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }

        .wrap {
            width: min(69.375rem, 100% - 3rem);
            margin-inline: auto;
        }

        /* ---------- Navbar (px on purpose: identical to the Login page navbar) ---------- */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            background: var(--bg);
            border-bottom: 1px solid rgba(255, 255, 255, .07);
        }

        .topbar-inner {
            height: 74px;
            padding: 0 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: var(--display);
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -0.01em;
            color: var(--text);
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--purple);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 15px;
            font-weight: 500;
            color: #c9d2e8;
        }

        .nav-links a { transition: color .15s ease; }
        .nav-links a:hover { color: #fff; }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-login,
        .btn-getstarted {
            display: inline-flex;
            align-items: center;
            height: 38px;
            padding: 0 22px;
            border-radius: 999px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
            transition: background-color .15s ease, border-color .15s ease;
        }

        .btn-login {
            border: 1px solid rgba(255, 255, 255, .28);
        }

        .btn-login:hover {
            background: rgba(255, 255, 255, .06);
            border-color: rgba(255, 255, 255, .45);
        }

        .btn-getstarted {
            background: var(--purple);
        }

        .btn-getstarted:hover { background: #6d4ce8; }

        /* ---------- Hero ---------- */
        .hero {
            min-height: calc(100vh - 74px);
            display: flex;
            align-items: center;
            padding-block: 2.5rem 3rem;
        }

        .hero .wrap {
            display: grid;
            grid-template-columns: minmax(0, 33.75rem) minmax(0, 30rem);
            justify-content: space-between;
            align-items: center;
            column-gap: 3rem;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            height: 2.25rem;
            padding: 0 .9375rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: rgba(255, 255, 255, .02);
            color: #e4e7f1;
            font-size: .84375rem;
            font-weight: 500;
        }

        .hero-badge .ic { color: var(--orange); font-size: .875rem; }

        .hero h1 {
            margin: 1.5rem 0 0;
            font-family: var(--display);
            font-weight: 800;
            font-size: clamp(2.6rem, 6vw, 4.25rem);
            line-height: 1.07;
            letter-spacing: -0.035em;
            color: var(--text);
        }

        .hero h1 .accent { color: var(--orange); }

        .hero-sub {
            margin: 1.75rem 0 0;
            max-width: 33.75rem;
            font-size: 1.1875rem;
            line-height: 1.875rem;
            letter-spacing: -0.012em;
            color: var(--text-soft);
        }

        .hero-actions {
            margin-top: 2.0625rem;
            display: flex;
            align-items: center;
            gap: 1.1875rem;
            flex-wrap: wrap;
        }

        .btn-start {
            display: inline-flex;
            align-items: center;
            gap: .625rem;
            height: 3.3125rem;
            padding: 0 1.625rem;
            border-radius: .875rem;
            background: var(--indigo);
            color: #fff;
            font-family: var(--body);
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: -0.01em;
            transition: background-color .15s ease, transform .15s ease;
        }

        .btn-start:hover { background: var(--indigo-hover); }
        .btn-start:active { transform: translateY(1px); }
        .btn-start .ic { font-size: 1rem; }

        .free-note {
            display: inline-flex;
            align-items: center;
            gap: .6875rem;
            font-size: .84375rem;
            color: var(--text-soft);
            letter-spacing: -0.005em;
        }

        .free-note .tick {
            width: 1.625rem;
            height: 1.625rem;
            border-radius: 50%;
            background: #1a2238;
            color: var(--orange);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .75rem;
        }

        .hero-meta {
            margin-top: 3.25rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--line);
            display: grid;
            grid-template-columns: 11.5625rem 11.5625rem 1fr;
            font-size: .84375rem;
            color: var(--text-muted);
        }

        /* ---------- Hero visual ---------- */
        .hero-visual {
            position: relative;
            justify-self: end;
            width: 100%;
            max-width: 30rem;
        }

        .frame {
            padding: .75rem;
            border: 1.5px solid var(--line);
            border-radius: 1.875rem;
            background: var(--surface);
        }

        .frame-img {
            display: block;
            width: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            object-position: center; /* photo is pre-cropped to 4:5 around the student */
            border-radius: 1.25rem;
            background: var(--surface-2);
        }

        .float-card {
            position: absolute;
            border-radius: 1.125rem;
        }

        .float-chapter {
            top: 2.8125rem;
            left: -2.8125rem;
            width: 9.4375rem;
            padding: .875rem .875rem .8125rem;
            background: #fff;
            color: var(--ink);
            box-shadow: 0 1rem 2rem -1rem rgba(0, 0, 0, .5);
        }

        .float-chapter .ic {
            display: block;
            font-size: 1.25rem;
            color: var(--orange);
            margin-bottom: .625rem;
        }

        .float-label {
            display: block;
            font-size: .6875rem;
            font-weight: 600;
            letter-spacing: .02em;
            text-transform: uppercase;
        }

        .float-chapter .float-label { color: #5a6378; }

        .float-chapter strong {
            display: block;
            margin-top: .1875rem;
            font-family: var(--display);
            font-size: .9375rem;
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.01em;
        }

        .float-review {
            right: -1.6875rem;
            bottom: -1.25rem;
            width: 12.875rem;
            padding: 1.125rem 1.125rem 1.0625rem;
            background: var(--orange);
            color: var(--ink);
            box-shadow: 0 1rem 2rem -1rem rgba(0, 0, 0, .5);
        }

        .float-review .float-label { color: rgba(10, 16, 36, .78); }

        .float-review strong {
            display: block;
            margin-top: .4375rem;
            font-family: var(--display);
            font-size: 1.125rem;
            font-weight: 800;
            line-height: 1.22;
            letter-spacing: -0.015em;
        }

        /* ---------- Shared section styles ---------- */
        .section {
            padding-block: 6rem;
        }

        .section-head {
            max-width: 38.75rem;
            margin-bottom: 3.25rem;
        }

        .section-head h2,
        .about-grid h2 {
            margin: 0;
            font-family: var(--display);
            font-weight: 800;
            font-size: clamp(1.875rem, 4vw, 2.625rem);
            line-height: 1.1;
            letter-spacing: -0.03em;
            color: var(--text);
        }

        .section-head p {
            margin: 1rem 0 0;
            font-size: 1.0625rem;
            line-height: 1.6875rem;
            letter-spacing: -0.01em;
            color: var(--text-soft);
        }

        /* ---------- Features ---------- */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.25rem;
        }

        .feature-card {
            padding: 1.625rem 1.5rem 1.75rem;
            border: 1px solid var(--line);
            border-radius: 1.375rem;
            background: var(--surface);
            transition: border-color .2s ease, background-color .2s ease;
        }

        .feature-card:hover {
            border-color: #2b3a66;
            background: var(--surface-2);
        }

        .tile {
            width: 2.875rem;
            height: 2.875rem;
            border-radius: .875rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.375rem;
        }

        .tile.orange { background: var(--orange-soft); color: var(--orange); }
        .tile.indigo { background: var(--indigo-soft); color: var(--indigo-text); }

        .feature-card h3 {
            margin: 1.375rem 0 0;
            font-family: var(--display);
            font-size: 1.125rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .feature-card p {
            margin: .625rem 0 0;
            font-size: .90625rem;
            line-height: 1.4375rem;
            color: var(--text-muted);
        }

        /* ---------- How it works ---------- */
        .how {
            border-block: 1px solid var(--line);
            background: #080e22;
        }

        .steps {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;
        }

        .step { position: relative; }

        .step:not(:last-child)::before {
            content: "";
            position: absolute;
            top: 1.1875rem;
            left: 3.25rem;
            right: -.75rem;
            height: 1px;
            background: var(--line);
        }

        .step-num {
            position: relative;
            width: 2.375rem;
            height: 2.375rem;
            border-radius: 50%;
            background: #1a2238;
            border: 1px solid #2b3a66;
            color: var(--orange);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: var(--display);
            font-weight: 800;
            font-size: .9375rem;
        }

        .step h3 {
            margin: 1.375rem 0 0;
            font-family: var(--display);
            font-size: 1.125rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .step p {
            margin: .625rem 0 0;
            max-width: 14.375rem;
            font-size: .90625rem;
            line-height: 1.4375rem;
            color: var(--text-muted);
        }

        /* ---------- About ---------- */
        .about-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
            column-gap: 4rem;
            align-items: start;
        }

        .about-grid p {
            margin: 0;
            font-size: 1.0625rem;
            line-height: 1.75rem;
            letter-spacing: -0.01em;
            color: var(--text-soft);
        }

        .about-grid p + p { margin-top: 1.125rem; }

        .about-grid em {
            font-style: normal;
            color: var(--text);
            font-weight: 500;
        }

        /* ---------- CTA ---------- */
        .cta-section { padding-bottom: 6rem; }

        .cta-banner {
            border: 1px solid rgba(255, 92, 0, .26);
            border-radius: 1.875rem;
            background: var(--surface);
            color: var(--text);
            padding: 4rem 2rem;
            text-align: center;
        }

        .cta-banner h2 {
            margin: 0;
            font-family: var(--display);
            font-weight: 800;
            font-size: clamp(1.875rem, 4.4vw, 2.875rem);
            line-height: 1.08;
            letter-spacing: -0.035em;
        }

        .cta-banner p {
            margin: .875rem auto 0;
            max-width: 30rem;
            font-size: 1.0625rem;
            line-height: 1.625rem;
            color: var(--text-soft);
        }

        .btn-cta {
            margin-top: 1.875rem;
            display: inline-flex;
            align-items: center;
            gap: .625rem;
            height: 3.3125rem;
            padding: 0 1.625rem;
            border-radius: .875rem;
            background: var(--orange);
            color: var(--ink);
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            transition: background-color .15s ease, transform .15s ease;
        }

        .btn-cta:hover { background: #ff7024; }
        .btn-cta:active { transform: translateY(1px); }
        .btn-cta .ic { font-size: 1rem; }

        /* ---------- Footer ---------- */
        .site-footer {
            border-top: 1px solid var(--line);
            padding-block: 2rem;
        }

        .site-footer .wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem 1.5rem;
            flex-wrap: wrap;
            font-size: .84375rem;
            color: var(--text-muted);
        }

        .site-footer .brand { font-size: 1.0625rem; }
        .site-footer .brand-mark { width: 1.875rem; height: 1.875rem; border-radius: .5625rem; font-size: 1rem; }

        .footer-links {
            display: flex;
            gap: 1.375rem;
        }

        .footer-links a:hover { color: #fff; }

        /* ---------- Accessibility ---------- */
        a:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 3px;
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 1040px) {
            .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
            .step::before { display: none; }
        }

        @@media (max-width: 960px) {
            /* layout stacks here, so it no longer has to fit one screen: use a fixed size */
            html { font-size: 75%; }

            .hero { padding-block: 1.5rem 4.5rem; min-height: 0; }

            .hero .wrap {
                grid-template-columns: minmax(0, 1fr);
                row-gap: 4rem;
            }

            .hero-visual { justify-self: center; }

            .float-chapter { left: -.75rem; }
            .float-review { right: -.75rem; }

            .section { padding-block: 4.5rem; }
            .about-grid { grid-template-columns: minmax(0, 1fr); row-gap: 1.5rem; }
        }

        @@media (max-width: 900px) {
            .nav-links { display: none; }
            .topbar-inner { padding: 0 20px; }
        }

        /* phones: bigger root so text stays readable */
        @@media (max-width: 700px) {
            html { font-size: 87.5%; }
        }

        @@media (max-width: 620px) {
            .feature-grid,
            .steps { grid-template-columns: minmax(0, 1fr); }

            .step p { max-width: none; }
            .cta-banner { padding: 3rem 1.375rem; border-radius: 1.5rem; }
        }

        @@media (max-width: 520px) {
            .hero-meta {
                grid-template-columns: repeat(3, auto);
                justify-content: space-between;
                font-size: .78rem;
            }

            .float-chapter { width: 8.6rem; top: 1.75rem; }
            .float-review { width: 11.6rem; }
            .float-review strong { font-size: 1.03rem; }
        }

        @@media (max-width: 400px) {
            .btn-login { display: none; }
        }
    </style>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="EduSathi home">
                <span class="brand-mark" aria-hidden="true">
                    <svg class="ic" viewBox="0 0 24 24">
                        <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" fill="currentColor" />
                        <path d="M22 10v6" />
                        <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
                    </svg>
                </span>
                EduSathi
            </a>

            <nav class="nav-links" aria-label="Primary">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="features">Features</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How It Works</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
            </nav>

            <div class="nav-actions">
                <a class="btn-login" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn-getstarted" asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </div>
    </header>

    <main>

        <!-- ================= HERO ================= -->
        <section class="hero" id="home">
            <div class="wrap">

                <div class="hero-copy">
                    <span class="hero-badge">
                        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
                            <path d="M20 3v4" /><path d="M22 5h-4" /><path d="M4 17v2" /><path d="M5 18H3" />
                        </svg>
                        Built for focused learning
                    </span>

                    <h1>Your notes, made <span class="accent">study-ready.</span></h1>

                    <p class="hero-sub">
                        Upload a PDF. Get the important ideas, practice at your level,
                        and turn any chapter into a focused study session.
                    </p>

                    <div class="hero-actions">
                        <a class="btn-start" asp-controller="Account" asp-action="Register">
                            Start studying
                            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                        </a>
                        <span class="free-note">
                            <span class="tick" aria-hidden="true">
                                <svg class="ic" viewBox="0 0 24 24" style="stroke-width:2.6"><path d="M20 6 9 17l-5-5" /></svg>
                            </span>
                            Your first study space is free
                        </span>
                    </div>

                    <div class="hero-meta">
                        <span>Smart summaries</span>
                        <span>Practice sets</span>
                        <span>Questionnaires</span>
                    </div>
                </div>

                <div class="hero-visual">
                    <div class="frame">
                        <!-- Photo is embedded (base64). If it ever fails to load, onerror hides the broken-image icon and the dark box shows instead. -->
                        <img class="frame-img" src="data:image/jpeg;base64,"
                             alt="A student taking notes at a desk under a lamp"
                             onerror="this.style.visibility='hidden'" />
                    </div>

                    <div class="float-card float-chapter" aria-hidden="true">
                        <svg class="ic" viewBox="0 0 24 24">
                            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                            <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                            <path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" />
                        </svg>
                        <span class="float-label"></span>
                        <strong>Neural pathways</strong>
                    </div>

                    <div class="float-card float-review" aria-hidden="true">
                        <span class="float-label">Ready to review</span>
                        <strong>12 key ideas extracted</strong>
                    </div>
                </div>

            </div>
        </section>

        <!-- ================= FEATURES ================= -->
        <section class="section" id="features">
            <div class="wrap">
                <div class="section-head">
                    <h2>Everything you need to study smarter</h2>
                    <p>One upload unlocks summaries, practice, quizzes and competitive study battles.</p>
                </div>

                <div class="feature-grid">
                    <article class="feature-card">
                        <span class="tile orange" aria-hidden="true">
                            <svg class="ic" viewBox="0 0 24 24"><path d="M12 7v14" /><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></svg>
                        </span>
                        <h3>AI Study Summary</h3>
                        <p>Upload study materials and receive organized, easy-to-scan summaries with key takeaways.</p>
                    </article>

                    <article class="feature-card">
                        <span class="tile indigo" aria-hidden="true">
                            <svg class="ic" viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z" /></svg>
                        </span>
                        <h3>Smart Practice</h3>
                        <p>Practice Easy, Medium and Hard written questions generated straight from your file.</p>
                    </article>

                    <article class="feature-card">
                        <span class="tile orange" aria-hidden="true">
                            <svg class="ic" viewBox="0 0 24 24"><rect width="8" height="4" x="8" y="2" rx="1" ry="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><path d="m9 14 2 2 4-4" /></svg>
                        </span>
                        <h3>Interactive Quiz</h3>
                        <p>Answer generated MCQs, get instant feedback and earn scores and XP as you go.</p>
                    </article>

                    <article class="feature-card">
                        <span class="tile indigo" aria-hidden="true">
                            <svg class="ic" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                        </span>
                        <h3>Study Battles</h3>
                        <p>Share a room code and compete with friends using questions built from your study materials.</p>
                    </article>
                </div>
            </div>
        </section>

        <!-- ================= HOW IT WORKS ================= -->
        <section class="section how" id="how-it-works">
            <div class="wrap">
                <div class="section-head">
                    <h2>How it works</h2>
                    <p>From PDF to practice in four simple steps.</p>
                </div>

                <div class="steps">
                    <div class="step">
                        <span class="step-num">1</span>
                        <h3>Upload a PDF</h3>
                        <p>Drop in lecture notes, textbook chapters or past papers.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">2</span>
                        <h3>Get your summary</h3>
                        <p>Review an AI-generated overview and key takeaways.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">3</span>
                        <h3>Practice &amp; quiz</h3>
                        <p>Work through Easy, Medium and Hard questions at your pace.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">4</span>
                        <h3>Compete</h3>
                        <p>Share a code and battle friends on the same material.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= ABOUT ================= -->
        <section class="section" id="about">
            <div class="wrap about-grid">
                <h2>About EduSathi</h2>
                <div>
                    <p>
                        EduSathi (<em>sathi</em> means &ldquo;friend&rdquo; in Nepali) is a study companion built to help
                        students turn dense study material into something they can actually practice with.
                    </p>
                    <p>
                        It started at a hackathon, and it&rsquo;s designed to keep helping long after.
                    </p>
                </div>
            </div>
        </section>

        <!-- ================= CTA ================= -->
        <section class="cta-section">
            <div class="wrap">
                <div class="cta-banner">
                    <h2>Ready to study smarter?</h2>
                    <p>Create your free account and turn your first PDF into a quiz in minutes.</p>
                    <a class="btn-cta" asp-controller="Account" asp-action="Register">
                        Start learning
                        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                    </a>
                </div>
            </div>
        </section>

    </main>

    <footer class="site-footer">
        <div class="wrap">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="EduSathi home">
                <span class="brand-mark" aria-hidden="true">
                    <svg class="ic" viewBox="0 0 24 24">
                        <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" fill="currentColor" />
                        <path d="M22 10v6" />
                        <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
                    </svg>
                </span>
                EduSathi
            </a>

            <span>&copy; @DateTime.Now.Year EduSathi</span>
        </div>
    </footer>

</body>
</html>
