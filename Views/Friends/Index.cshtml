@*
    Views/Friends/Index.cshtml — restyled to match EduSathi's dark UI.
    Posts to the real FriendsController: SendRequest(friendEmail), AcceptRequest(id),
    RejectRequest(id) — used for both declining a received request and cancelling
    a sent one, since the controller allows either side to call it.
*@
@using System.Security.Claims
@using EduSathi.Models
@model FriendsViewModel
@{
    ViewData["Title"] = "Friends";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    string NameOf(ApplicationUser u) => string.IsNullOrWhiteSpace(u.FullName) ? (u.Email ?? "Student") : u.FullName;
}

<div class="page-header">
    <div>
        <h1>Your Friends &amp; Study Buddies</h1>
        <p class="subtitle">Add friends by email, then invite them straight into your quiz rooms.</p>
    </div>
</div>

<div class="card">
    <h3 style="margin-bottom:12px;">Add New Friend</h3>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="field-errors" style="margin-bottom:12px;">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="color:var(--green);font-size:13px;margin-bottom:12px;">@TempData["SuccessMessage"]</div>
    }
    <form asp-action="SendRequest" method="post" style="display:flex;gap:8px;">
        <input type="email" name="friendEmail" class="auth-input" placeholder="Enter friend's Gmail address..." style="margin-bottom:0;" />
        <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Send Friend Request</button>
    </form>
</div>

<div class="card">
    <h3 style="margin-bottom:14px;">Pending Friend Requests <span style="color:var(--text-muted);font-weight:500;">(@Model.ReceivedRequests.Count)</span></h3>
    @if (!Model.ReceivedRequests.Any())
    {
        <p class="desc">No pending requests received.</p>
    }
    else
    {
        foreach (var f in Model.ReceivedRequests)
        {
            <div class="list-item" style="margin-bottom:10px;">
                <div class="icon-circle purple"><i class="bi bi-person-fill"></i></div>
                <div class="info">
                    <div class="title">@NameOf(f.User)</div>
                    <div class="meta">@f.User.Email</div>
                </div>
                <div style="display:flex;gap:8px;">
                    <form asp-action="AcceptRequest" method="post"><input type="hidden" name="id" value="@f.Id" /><button type="submit" class="chip-btn green">Accept</button></form>
                    <form asp-action="RejectRequest" method="post"><input type="hidden" name="id" value="@f.Id" /><button type="submit" class="chip-btn orange">Decline</button></form>
                </div>
            </div>
        }
    }
</div>

<div class="card">
    <h3 style="margin-bottom:14px;">Sent Requests Pending Response <span style="color:var(--text-muted);font-weight:500;">(@Model.SentRequests.Count)</span></h3>
    @if (!Model.SentRequests.Any())
    {
        <p class="desc">You have no pending sent requests.</p>
    }
    else
    {
        foreach (var f in Model.SentRequests)
        {
            <div class="list-item" style="margin-bottom:10px;">
                <div class="icon-circle blue"><i class="bi bi-person-fill"></i></div>
                <div class="info">
                    <div class="title">@NameOf(f.Friend)</div>
                    <div class="meta">@f.Friend.Email</div>
                </div>
                <form asp-action="RejectRequest" method="post"><input type="hidden" name="id" value="@f.Id" /><button type="submit" class="chip-btn orange">Cancel</button></form>
            </div>
        }
    }
</div>

<div class="card">
    <h3 style="margin-bottom:14px;">My Friends List <span style="color:var(--text-muted);font-weight:500;">(@Model.Friends.Count)</span></h3>
    @if (!Model.Friends.Any())
    {
        <div class="empty-state">
            <div class="icon-circle purple lg"><i class="bi bi-people"></i></div>
            <h3>No friends yet</h3>
            <p>Send a request above to start building your study group.</p>
        </div>
    }
    else
    {
        foreach (var f in Model.Friends)
        {
            var other = f.UserId == currentUserId ? f.Friend : f.User;
            var name = NameOf(other);
            var initials = "";
            foreach (var part in name.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            {
                if (initials.Length >= 2) break;
                initials += char.ToUpperInvariant(part[0]);
            }
            if (initials.Length == 0) { initials = "?"; }

            <div class="list-item" style="margin-bottom:10px;">
                <div class="icon-circle purple">@initials</div>
                <div class="info">
                    <div class="title">@name</div>
                    <div class="meta">@other.Email</div>
                </div>
            </div>
        }
    }
</div>