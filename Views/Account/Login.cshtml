@*
    Views/Account/Login.cshtml — COMPLETE REPLACEMENT.

    Restyled from Login.aspx. The form contract is UNCHANGED from your existing
    Login.cshtml, so AccountController.Login needs no edit:

      action           -> Account/Login  with asp-route-returnUrl="@ViewData["ReturnUrl"]"
      input names      -> email, password
      validation       -> asp-validation-summary="All"  (shows "Invalid login attempt.")
      autocomplete     -> username / current-password, kept for password managers

    Only the markup and classes changed. The "Register as a new user" link keeps
    pointing at Account/Register.
*@
@{
    ViewData["Title"] = "Login";
    Layout = "_PublicLayout";
}

<section class="auth-section">
    <div class="card auth-card">
        <div class="auth-header">
            <div class="icon-circle purple lg"><i class="bi bi-mortarboard-fill"></i></div>
            <h1>Welcome back</h1>
            <p class="desc">Log in to pick up where you left off.</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div asp-validation-summary="All" class="field-errors"></div>

            <div class="field-label">Email / Username</div>
            <input name="email" class="auth-input" autocomplete="username" aria-required="true"
                   placeholder="you@@example.com" required />

            <div class="field-label" style="margin-top:14px;">Password</div>
            <input name="password" type="password" class="auth-input" autocomplete="current-password"
                   aria-required="true" placeholder="Enter your password" required />

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:18px;">Log In</button>
        </form>

        <p class="auth-switch">
            Don't have an account? <a asp-controller="Account" asp-action="Register">Register as a new user</a>
        </p>
    </div>
</section>
