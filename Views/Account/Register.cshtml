@*
    Views/Account/Register.cshtml — COMPLETE REPLACEMENT.

    Restyled from Signup.aspx. The form contract is UNCHANGED from your existing
    Register.cshtml, so AccountController.Register needs no edit:

      action       -> Account/Register
      input names  -> fullName, contact, email, password, confirmPassword
      validation   -> asp-validation-summary="All"  (password-mismatch + Identity errors)

    NOTE — the "Grade / Level" dropdown from Signup.aspx is NOT here. ApplicationUser
    has FullName and ContactNumber only, and Register() binds exactly five fields.
    Adding Grade would mean a model change, a migration and a controller signature
    change, which is your teammates' call, not a frontend migration. Contact Number
    is theirs and is required, so it stays.

    To add Grade later: add `public string Grade { get; set; }` to ApplicationUser,
    add a migration, add the parameter to Register(), then drop a <select
    name="grade" class="auth-input"> into the block below.
*@
@{
    ViewData["Title"] = "Register";
    Layout = "_PublicLayout";
}

<section class="auth-section">
    <div class="card auth-card">
        <div class="auth-header">
            <div class="icon-circle purple lg"><i class="bi bi-mortarboard-fill"></i></div>
            <h1>Create your account</h1>
            <p class="desc">Start turning your notes into smarter learning.</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="Register">
            <div asp-validation-summary="All" class="field-errors"></div>

            <div class="field-label">Full name</div>
            <input name="fullName" class="auth-input" placeholder="Yamuna Acharya" required />

            <div class="field-label" style="margin-top:14px;">Contact number</div>
            <input name="contact" class="auth-input" placeholder="98XXXXXXXX" required />

            <div class="field-label" style="margin-top:14px;">Email</div>
            <input name="email" class="auth-input" autocomplete="username"
                   placeholder="you@@example.com" required />

            <div class="field-label" style="margin-top:14px;">Password</div>
            <input name="password" type="password" class="auth-input" autocomplete="new-password"
                   placeholder="Create a password" required />

            <div class="field-label" style="margin-top:14px;">Confirm password</div>
            <input name="confirmPassword" type="password" class="auth-input" autocomplete="new-password"
                   placeholder="Repeat your password" required />

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:18px;">Create Account</button>
        </form>

        <p class="auth-switch">
            Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a>
        </p>
    </div>
</section>
