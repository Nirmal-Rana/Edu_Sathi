@*
    Views/Questionnaires/RoomInvites.cshtml — restyled to match EduSathi's dark UI.
    Bootstrap classes (container/card/list-group/text-primary/etc.) replaced with
    the existing .page-header/.card/.list-item/.chip-btn tokens.
*@
@model List<EduSathi.Models.CustomRoom>

@{
    ViewData["Title"] = "Room Invitations";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1>Your Room Invitations</h1>
        <p class="subtitle">Live quiz sessions you have been invited to by your peers.</p>
    </div>
</div>

<div class="card">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="icon-circle purple lg"><i class="bi bi-envelope-open"></i></div>
            <h3>No invitations right now</h3>
            <p>You have no pending room invitations or active quizzes right now.</p>
        </div>
    }
    else
    {
        foreach (var room in Model)
        {
            <div class="list-item" style="margin-bottom:10px;">
                <div class="icon-circle orange"><i class="bi bi-collection-fill"></i></div>
                <div class="info">
                    <div class="title">@room.RoomName</div>
                    <div class="meta">Room Code: <strong style="color:var(--primary);">@room.RoomCode</strong></div>
                </div>
                <a asp-action="RoomLobby" asp-route-roomCode="@room.RoomCode" class="chip-btn blue">
                    Enter Lobby <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
    }
</div>