@model EduSathi.Models.CustomRoom

@{
    ViewData["Title"] = "Room Leaderboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4 border-0 bg-white">
        <div class="text-center mb-4">
            <span class="badge bg-success mb-2 px-3 py-2 text-uppercase">Live Room Completed</span>
            <h2 class="fw-bold text-primary">@Model.RoomName</h2>
            <p class="text-muted">Leaderboard rankings based on performance in room code: <strong>@Model.RoomCode</strong></p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Rank</th>
                        <th>Participant Name</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Score Secured</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                    }
                    @foreach (var participant in Model.Participants.OrderByDescending(p => p.Score))
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                @if (rank == 1)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-trophy-fill"></i> 1st</span>
                                }
                                else if (rank == 2)
                                {
                                    <span class="badge bg-secondary px-2 py-1">2nd</span>
                                }
                                else if (rank == 3)
                                {
                                    <span class="badge bg-danger px-2 py-1">3rd</span>
                                }
                                else
                                {
                                    <span>#@rank</span>
                                }
                            </td>
                            <td class="fw-semibold text-dark">
                                <i class="bi bi-person-circle text-primary me-2"></i> @participant.UserName
                            </td>
                            <td>
                                @if (participant.HasSubmitted)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Submitted</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">Waiting / In Progress</span>
                                }
                            </td>
                            <td class="text-end pe-4 fw-bold text-dark fs-5">
                                @participant.Score pts
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-primary px-5">Back to Questionaries Hub</a>
        </div>
    </div>
</div>