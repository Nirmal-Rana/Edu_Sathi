@*
    Views/Questionnaires/RoomQuiz.cshtml — NEW FILE.

    Same answerable-MCQ markup contract as Views/Exam/Quiz.cshtml (edusathi.css
    keys correct/incorrect states off .option-list li:has(input.correct/:checked)),
    plus a leaderboard card for Global rooms once at least one person has
    finished. The leaderboard updates live via Hubs/RoomHub's LeaderboardUpdated
    event - see wwwroot/js/room-live.js.
*@
@using EduSathi.Models
@using EduSathi.ViewModels
@model RoomQuizViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var isGlobal = Model.Category == RoomCategory.Global;
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="subtitle quiz-meta-inline">@Model.Total question@(Model.Total == 1 ? "" : "s") @(isGlobal ? "· Live Room " + Model.RoomCode : "· Solo practice")</p>
    </div>
    <a class="btn-back" asp-action="MyQuizzes"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (Model.IsSubmitted)
{
    <div class="score-banner">
        <div>
            <div class="score-value">@Model.CorrectCount/@Model.Total</div>
            <div class="score-label">correct answers</div>
        </div>
        <div style="flex:1;">
            <div style="font-weight:700;">+@Model.XpEarned XP</div>
            <div class="score-label">@Model.PercentCorrect% correct</div>
        </div>
    </div>

    @if (isGlobal)
    {
        <div class="card" data-room-code="@Model.RoomCode" data-leaderboard>
            <h3 style="margin-bottom:14px;"><i class="bi bi-trophy-fill" style="color:var(--orange);"></i> Leaderboard</h3>
            <div id="leaderboardList">
                @{ var rank = 0; }
                @foreach (var entry in Model.Leaderboard)
                {
                    rank++;
                    <div class="list-item" style="margin-bottom:10px;">
                        <div class="icon-circle @(rank == 1 ? "orange" : "purple")">
                            @if (rank == 1) { <i class="bi bi-trophy-fill"></i> } else { <span>@rank</span> }
                        </div>
                        <div class="info">
                            <div class="title">@entry.DisplayName @(entry.IsHost ? "(Host)" : "")</div>
                            <div class="meta">@(entry.Finished ? entry.Score + "/" + entry.Total + " correct" : "Still playing…")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@if (Model.Total == 0)
{
    <div class="empty-state">
        <div class="icon-circle purple lg"><i class="bi bi-question-circle"></i></div>
        <h3>No questions in this room yet</h3>
        <p>The attached document doesn't have any generated questions.</p>
        <a class="btn btn-primary" asp-action="Index">Back to Questionnaires</a>
    </div>
}
else if (!Model.IsSubmitted)
{
    <form method="post" asp-action="RoomQuiz">
        @if (isGlobal)
        {
            <input type="hidden" name="roomCode" value="@Model.RoomCode" />
        }
        else
        {
            <input type="hidden" name="id" value="@Model.RoomId" />
        }

        @{ var number = 0; }
        @foreach (var q in Model.Questions)
        {
            number++;
            <div class="question-card">
                <div class="q-head">
                    <div class="q-number">@number</div>
                    <div class="q-text">@q.QuestionText</div>
                </div>

                <div class="option-list">
                    <ol>
                        @foreach (var (letter, text) in RoomQuizViewModel.OptionsOf(q))
                        {
                            var inputId = $"q{q.Id}_{letter}";
                            <li>
                                <input type="radio" id="@inputId" name="answers[@q.Id]" value="@letter" />
                                <label for="@inputId">@text</label>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        }

        <div class="sticky-submit-bar">
            <span class="answered-count" data-answered-count>0/@Model.Total answered</span>
            <button type="submit" class="btn btn-primary">Submit Answers</button>
        </div>
    </form>
}

@section Scripts {
    @if (isGlobal)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/room-live.js" asp-append-version="true"></script>
    }
}