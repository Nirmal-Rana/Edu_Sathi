@model EduSathi.ViewModels.RoomQuizViewModel

@{
    ViewData["Title"] = "Room Quiz";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="page-header mb-4">
    <div>
        <h1>@Model.Name</h1>
        @if (Model.Category == EduSathi.Models.RoomCategory.Global && !string.IsNullOrEmpty(Model.RoomCode))
        {
            <p class="subtitle text-muted">Room Code: <strong>@Model.RoomCode</strong></p>
        }
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Exit Quiz</a>
</div>

<div class="row">
    <!-- Quiz Questions Column -->
    <div class="col-lg-8">
        <form asp-action="RoomQuiz" method="post">
            <input type="hidden" name="roomCode" value="@Model.RoomCode" />
            <input type="hidden" name="id" value="@Model.RoomId" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var qNum = i + 1;
                var picked = Model.Answers != null && Model.Answers.ContainsKey(q.Id) ? Model.Answers[q.Id] : null;

                <div class="card mb-4 p-4 shadow-sm border-0 bg-white" style="color: #0b1226;">
                    <h5 class="fw-bold mb-4" style="color: #0b1226; line-height: 1.5;">@qNum. @q.QuestionText</h5>
                    
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var opt in new[] { "A", "B", "C", "D" })
                        {
                            var optText = opt == "A" ? q.OptionA : opt == "B" ? q.OptionB : opt == "C" ? q.OptionC : q.OptionD;
                            var isChecked = picked == opt;
                            var isCorrect = Model.IsSubmitted && q.CorrectOption == opt;
                            var isWrong = Model.IsSubmitted && isChecked && !isCorrect;
                            
                            var bgStyle = "background: #f8f9fc; border: 1px solid #e1e6f0; color: #26304a;";
                            if (Model.IsSubmitted) {
                                if (isCorrect) bgStyle = "background: #e6f9f0; border: 1px solid #28a745; color: #155724;";
                                else if (isWrong) bgStyle = "background: #fdecef; border: 1px solid #dc3545; color: #721c24;";
                            }

                            <label style="display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: 10px; cursor: pointer; @bgStyle transition: all 0.15s ease;">
                                <input type="radio" name="answers[@q.Id]" value="@opt" @(isChecked ? "checked" : "") @(Model.IsSubmitted ? "disabled" : "") style="margin-top: 3px; accent-color: #7c5cf5;" />
                                <div>
                                    <strong style="margin-right: 4px;">@opt.</strong> @optText
                                </div>
                            </label>
                        }
                    </div>

                    @if (Model.IsSubmitted)
                    {
                        <!-- Added margin-top: 14px for proper breathing room -->
                        <div style="margin-top: 14px; padding: 14px; background: #f8f9fc; border: 1px solid #e1e6f0; border-radius: 10px; color: #26304a; line-height: 1.5;">
                            <strong style="color: #0b1226;"><i class="bi bi-info-circle text-primary"></i> Explanation:</strong> @q.Explanation
                        </div>
                    }
                </div>
            }

            @if (!Model.IsSubmitted)
            {
                <button type="submit" class="btn btn-primary btn-lg w-100 mb-5 shadow-sm" style="background: linear-gradient(90deg, #5d5cf5, #9463f4); border: none; border-radius: 12px; height: 48px; font-weight: 700;">
                    <i class="bi bi-check2-circle"></i> Submit Quiz
                </button>
            }
        </form>
    </div>

    <!-- Sidebar / Results Column -->
    <div class="col-lg-4">
        @if (Model.IsSubmitted)
        {
            <div class="card p-4 shadow-sm mb-4 text-center border-0 bg-white" style="color: #0b1226;">
                <h5 class="fw-bold text-muted text-uppercase mb-2" style="font-size: 13px;">Your Score</h5>
                <h1 class="text-primary display-4 fw-bold mb-0">@Model.CorrectCount <span class="fs-4 text-muted">/ @Model.Total</span></h1>
            </div>

            @if (Model.Category == EduSathi.Models.RoomCategory.Global && Model.Leaderboard != null)
            {
                <div class="card p-4 shadow-sm border-0 bg-white" style="color: #0b1226;">
                    <h5 class="fw-bold mb-3"><i class="bi bi-trophy-fill text-warning"></i> Live Leaderboard</h5>
                    <ul class="list-group list-group-flush" id="leaderboard-list">
                        @foreach (var entry in Model.Leaderboard)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3" style="border-bottom: 1px solid #e1e6f0;">
                                <div>
                                    <span class="fw-semibold text-dark">@entry.DisplayName</span>
                                    @if(entry.IsHost) { <span class="badge bg-secondary ms-2" style="font-size: 0.7rem;">Host</span> }
                                </div>
                                <span class="fw-bold text-primary fs-5">@(entry.Score.HasValue ? $"{entry.Score}/{entry.Total}" : "...")</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="card p-4 shadow-sm sticky-top border-0 bg-white" style="top: 20px; color: #0b1226;">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-square-fill text-primary"></i> Quiz Details</h5>
                <hr class="mt-0 mb-3" style="border-color: #e1e6f0;" />
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Questions</span>
                    <strong class="text-dark">@Model.Total</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Category</span>
                    <strong class="text-dark">@Model.Category</strong>
                </div>
            </div>
        }
    </div>
</div>