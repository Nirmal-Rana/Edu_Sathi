@*
    Views/Exam/History.cshtml — NEW FILE, backs the new ExamController.History action.

    Converted from History.aspx. The Repeater became a foreach; the two
    LinkButtons with CommandName="Summary"/"Quiz" became plain links, since both
    were only doing a Response.Redirect.

    Model is the raw List<UploadedDocument> from EF — no extra view model needed,
    everything shown is already on the entity.
*@
@model List<EduSathi.Models.UploadedDocument>

@{
    ViewData["Title"] = "Document History";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var newestId = Model.FirstOrDefault()?.Id;
}

<div class="page-header">
    <div>
        <h1>Document History</h1>
        <p class="subtitle">@Model.Count document@(Model.Count == 1 ? "" : "s") uploaded</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="icon-circle purple lg"><i class="bi bi-file-earmark-text"></i></div>
        <h3>Nothing here yet</h3>
        <p>Upload your first PDF and it'll show up here.</p>
        <a class="btn btn-primary" asp-action="Index"><i class="bi bi-cloud-arrow-up"></i> Upload a PDF</a>
    </div>
}
else
{
    foreach (var doc in Model)
    {
        <div class="list-item history-item-stack">
            <div style="display:flex;align-items:center;gap:14px;width:100%;">
                <div class="icon-circle orange"><i class="bi bi-file-earmark-text-fill"></i></div>
                <div class="info">
                    <div class="title">
                        @doc.FileName
                        @if (doc.Id == newestId)
                        {
                            <span class="tag-current">CURRENT</span>
                        }
                    </div>
                    <div class="meta">
                        @doc.UploadedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")
                        · @doc.Questions.Count question@(doc.Questions.Count == 1 ? "" : "s")
                    </div>
                </div>
            </div>
            <div class="list-item-actions">
                <a class="chip-btn blue" asp-action="QuizSession" asp-route-id="@doc.Id">
                    <i class="bi bi-journal-text"></i> Summary <i class="bi bi-arrow-up-right"></i>
                </a>
                <a class="chip-btn orange" asp-action="Quiz" asp-route-id="@doc.Id" asp-route-level="@EduSathi.Models.QuestionLevel.Basic">
                    <i class="bi bi-clipboard2-check"></i> Quiz <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>
    }
}
